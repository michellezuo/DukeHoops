# Copy to .env.local for local dev. Everything is optional: with no Supabase keys
# the app reads data/generated/*.json produced by the ingestion pipeline.

# --- Supabase (app reads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (ingestion writes; server/CI only, never expose to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3+ integrations ---
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
